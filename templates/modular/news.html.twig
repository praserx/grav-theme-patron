<div class="container news">
	<div class="row">
		<div class="col-sm-12 col-md-6">
			<div
				class="ui fluid vertical menu fe">
				{# In modular page to get collection, we have to use page variable #}
				{% for child in page.find(theme.settings.modules.news).collection()|slice(0, 5) %}
					{% set tag = child.header.taxonomy.tag|length > 0 ? child.header.taxonomy.tag|first : '' %}
					<a href="{{ child.url }}" class="item">
						{{ child.header.title }}
						{% if tag != '' %}
							&nbsp;<span class="ui red horizontal label">{{ tag }}</span>
						{% endif %}
					</a>
				{% endfor %}
			</div>
		</div>
		<div class="col-sm-12 col-md-6">
			<div class="ui piled segment fe">
				{{ content|raw }}
			</div>
		</div>
	</div>
</div>
