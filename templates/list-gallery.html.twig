{% extends 'partials/base.html.twig' %} {% set show_pagination =
header_var('show_pagination', [page, blog])|defined(true) %} {% block content %}

<div class="container">
    <div class="row">
        <div class="col-sm-12 breadcrumbs">
            {% include 'partials/breadcrumbs.html.twig' %}
        </div>
    </div>
    <div class="row">
        <div class="col-sm-12 page">
            <div class="ui link cards">
                {% for child in page.collection() %}
                <div class="card">
                    <a href="{{ child.url|e('html_attr') }}" class="image" style="max-height:150px;overflow:hidden;">
                        {% set first_image = child.media.images|first %}
                        {% if first_image %}
                        <img src="{{ first_image.url|e('html_attr') }}">
                        {% endif %}
                    </a>
                    <div class="content">
                        <a href="{{ child.url|e('html_attr') }}" class="header">{{ child.header.title|e }}</a>
                        <div class="meta"></div>
                        <div class="description"></div>
                        <div class="extra content">
                            <span class="right floated"></span>
                            <span>
                                <i class="image icon"></i>
                                {{ child.media.images|length }}
                            </span>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            {% if show_pagination and config.plugins.pagination.enabled and page.collection().params.pagination %}
                <div id="listing-footer">
                    {% include 'partials/pagination.html.twig' ignore missing with {base_url: page.url, pagination: page.collection().params.pagination} %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}
