{% macro renderMenuItem(visiblePage) %}
    {% if visiblePage.children.visible is empty or visiblePage.header.showsubnav == false %}
    <a class="item custom" href="{{ visiblePage.url|e('html_attr') }}">{{ visiblePage.title|e }}</a>
    {% else %}
    <div class="ui pointing dropdown link item top left custom">
        <span class="text">{{ visiblePage.title|e }}</span>
        <i class="dropdown icon"></i>
        <div class="menu">
            {% for gps_item in visiblePage.children.visible %}
            <a class="item" href="{{ gps_item.url|e('html_attr') }}">{{ gps_item.title|e }}</a>
            {% endfor %}

            {% for ps_item in visiblePage.header.subnav.items %}
            <a class="item" href="{{ ps_item.url|e('html_attr') }}">{{ ps_item.text|e }}</a>
            {% endfor %}
        </div>
    </div>
    {% endif %}
{% endmacro %}

