{% macro renderMenuItem(visiblePage) %}
	<div class="item">
		{% if visiblePage.children.visible is empty or visiblePage.header.showsubnav == false %}
			<div class="header">
				<a href="{{ visiblePage.url }}">{{ visiblePage.title }}</a>
			</div>
		{% else %}
			<div class="header">
				{{ visiblePage.title }}
			</div>
			<div class="menu">
				{% for gps_item in visiblePage.children.visible %}
					<a class="item" href="{{ gps_item.url }}">{{ gps_item.title }}</a>
				{% endfor %}

				{% for ps_item in visiblePage.header.subnav.items %}
					<a class="item" href="{{ ps_item.url }}">{{ ps_item.text }}</a>
				{% endfor %}
			</div>
		{% endif %}
	</div>
{% endmacro %}

<div class="button-menu-open">
	<button class="ui icon button" id="mobile-menu-button">
		<i class="fas fa-bars"></i>
	</button>
</div>

<div class="navigation-mobile-popup">
	<div class="button-menu-close">
		<button class="ui icon button" id="mobile-menu-button">
			<i class="fas fa-xmark"></i>
		</button>
	</div>

	<div class="ui vertical menu fluid">
		{% for visiblePage in page.find("/", true).parent.children.visible %}
			{% if visiblePage.header.visibility_requires_access|default(false) %}
				{% if config.plugins.login.enabled and grav.user.username %}
					{{ _self.renderMenuItem(visiblePage) }}
				{% endif %}
			{% else %}
				{{ _self.renderMenuItem(visiblePage) }}
			{% endif %}
		{% endfor %}

		{% if config.plugins.login.enabled and grav.user.username %}
			<div class="item">
				<div class="header">
					<span class="text">
						<i class="far fa-user"></i>&ensp;{{ grav.user.fullname }}
					</span>
				</div>
				<div class="menu">
					<a class="item" href="{{ base_url }}{{ config.plugins.login.route_profile }}">
						<i class="fas fa-user-circle"></i>&ensp;{{ 'LOGIN.ACCOUNT'|t }}
					</a>
					{% if grav.user.access.admin.login|lower == "true" %}
						<a class="item" href="{{ base_url }}{{ config.plugins.admin.route }}" target="_blank">
							<i class="fas fa-sliders-h"></i>&ensp;{{ 'LOGIN.ADMIN'|t }}
						</a>
					{% endif %}
					<a class="item" href="{{ base_url }}{{ config.plugins.login.route }}">
						<i class="fas fa-sign-out-alt"></i>&ensp;{{ 'LOGIN.LOGOUT'|t }}
					</a>
				</div>
			</div>
		{% elseif theme.settings.site.login_link_visible %}
			<a class="item custom" href="{{ base_url }}{{ config.plugins.login.route }}">
				<i class="fas fa-sign-in-alt"></i>&ensp;{{ 'LOGIN.LOGIN'|t }}</a>
		{% endif %}
	</div>
</div>

<script>
$(function() {
  $('#mobile-menu-button').on('click', function() {
    $('.navigation-mobile-popup').css('display', 'block');
  });
  $('.button-menu-close button').on('click', function() {
    $('.navigation-mobile-popup').css('display', 'none');
  });
});
</script>
